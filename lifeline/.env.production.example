# Settings for the online LifeLine (docs/deployment.md). Put these in the hosting site's
# "Variables" / "Environment" page. Never commit real values.

APP_NAME=LifeLine
APP_ENV=production
APP_DEBUG=false
# Make one with: php artisan key:generate --show
APP_KEY=
# The public link, for example https://lifeline-production.up.railway.app
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# From the host's MySQL service (Railway shows MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Password for every demo account online (requester@, donor@, pending@, admin@lifeline.test).
# Pick your own and share it only with your instructor.
SEED_PASSWORD=

# Real email (needed so new sign-ups can verify their email). Example: Gmail with an App Password.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=LifeLine
