# Settings for the online LifeLine (docs/deployment.md). Put these in the hosting site's
# "Variables" / "Environment" page. Never commit real values.

APP_NAME=LifeLine
APP_ENV=production
APP_DEBUG=false
# Make one with: php artisan key:generate --show
APP_KEY=
# The public link, for example https://lifeline-production.up.railway.app
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The whole database address. On Railway: New Variable -> Add Reference -> MySQL -> MYSQL_URL.
DB_CONNECTION=mysql
DB_URL=

# Must match the port under the domain in Railway Settings -> Networking.
PORT=8000

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Password for every demo account online (requester@, donor@, pending@, admin@lifeline.test).
# Pick your own and share it only with your instructor.
SEED_PASSWORD=

# Railway's Trial/Hobby plans block outgoing mail (SMTP): keep MAIL_MAILER=log and AUTO_VERIFY_EMAIL=true
# so new sign-ups count as verified at once (DEC-024).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@lifeline.test
MAIL_FROM_NAME=LifeLine
AUTO_VERIFY_EMAIL=true

# Where SMTP works (Railway Pro or another host), send real email instead: set AUTO_VERIFY_EMAIL=false and
# use these lines (Gmail with an App Password).
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=LifeLine
